PUBLIC_ENV="development"

# WanderTag API
PUBLIC_API_URL="http://localhost:8081/api/v1"

# Keycloak (docker compose in wandertag-backend brings this up with the realm imported)
PUBLIC_KEYCLOAK_URL="http://localhost:8181"
PUBLIC_KEYCLOAK_REALM="wandertag"
PUBLIC_KEYCLOAK_CLIENT_ID="wandertag-frontend"

# E2E test users (seeded by the realm import)
E2E_ADMIN_USER=admin
E2E_ADMIN_PASSWORD=admin
E2E_USER_USER=hiker
E2E_USER_PASSWORD=hiker
